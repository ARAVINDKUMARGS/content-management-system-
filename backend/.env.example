# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Shared Team Database)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/lumen_cms?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin
CLIENT_URL=http://localhost:5173
